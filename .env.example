DATABASE_URL=postgresql://fireline:fireline@localhost:5432/fireline

# --- Embeddings (pick one provider) ---
EMBEDDING_PROVIDER=openai          # openai | voyage | local | fake
# EMBEDDING_MODEL=                 # defaults per provider
# EMBEDDING_DIM=                   # defaults per provider (openai 1536, voyage 1024, local 384)
OPENAI_API_KEY=
# VOYAGE_API_KEY=

# --- Generation ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_S=8

# --- Retrieval ---
K_INCIDENTS=5
K_RUNBOOKS=3
MIN_SIMILARITY=0.25
