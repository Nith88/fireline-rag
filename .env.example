# --- Vector store (Chroma Cloud; leave CHROMA_API_KEY empty to use a local DB at CHROMA_PATH) ---
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# CHROMA_PATH=.chroma

# --- Embeddings (pick one provider) ---
EMBEDDING_PROVIDER=openai          # openai | gemini | voyage | local | fake
# EMBEDDING_MODEL=                 # defaults per provider
# EMBEDDING_DIM=                   # defaults per provider (openai 1536, voyage 1024, local 384)
OPENAI_API_KEY=
# VOYAGE_API_KEY=

# --- Generation ---
GOOGLE_API_KEY=                    # Gemini API key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-3.6-flash
LLM_TIMEOUT_S=30

# --- Retrieval ---
K_INCIDENTS=5
K_RUNBOOKS=3
MIN_SIMILARITY=0.25
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Email reports (SMTP). Leave SMTP_HOST empty to disable. ---
# Gmail: smtp.gmail.com / 587 / your address / an App Password (needs 2-step verification)
# SMTP_HOST=
# SMTP_PORT=587                    # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Reports may ONLY be sent to these: exact addresses and/or domains, comma-separated.
# EMAIL_ALLOWLIST=ops@your-company.com,@your-company.com
